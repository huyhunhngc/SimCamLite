---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@layouts/DocsLayout.astro';
import Callout from '@components/docs/Callout.astro';
import Steps from '@components/docs/Steps.astro';
import Tabs from '@components/docs/Tabs.astro';
import TabItem from '@components/docs/TabItem.astro';
import CardGrid from '@components/docs/CardGrid.astro';
import LinkCard from '@components/docs/LinkCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  entryId={entry.id}
  headings={headings}
>
  <Content components={{ Callout, Steps, Tabs, TabItem, CardGrid, LinkCard }} />
</DocsLayout>

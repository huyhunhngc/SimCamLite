---
const faqs = [
  {
    q: 'Do I need to modify my app’s code or add an SDK?',
    a: 'No. SimCam Lite never touches your app’s source code or dependencies. It injects a small loader via DYLD_INSERT_LIBRARIES that loads SimCamLiteInject.framework into Simulator user apps and emulates AVFoundation.',
  },
  {
    q: 'Does it work when I press Run in Xcode with the debugger attached?',
    a: 'Yes. Because Xcode sets its own DYLD_INSERT_LIBRARIES (for Main Thread Checker and diagnostics), open “Run from Xcode” in SimCam Lite—or run `simcam xcode setup`—once per project. Committing the shared scheme change is safe: Macs without SimCam Lite ignore the missing dylib.',
  },
  {
    q: 'Which macOS and iOS Simulator versions are supported?',
    a: 'SimCam Lite requires macOS 14.0 (Sonoma) or newer and Xcode with an iOS Simulator runtime (targeting iOS 16.0+ simulator apps).',
  },
  {
    q: 'Can I test QR code scanning and third-party camera libraries?',
    a: 'Yes—any app or library reading frames from AVCaptureVideoDataOutput, AVCapturePhotoOutput, or AVCaptureVideoPreviewLayer (including Vision, VisionKit data scanners on video frames, React Native, and Flutter camera plugins) receives the live feed. Note that AVFoundation’s built-in AVCaptureMetadataOutput QR detection is not emulated yet.',
  },
  {
    q: 'What features are currently not supported?',
    a: 'SimCam Lite does not yet support movie file recording (AVCaptureMovieFileOutput), built-in AVCaptureMetadataOutput detection, or multi-camera sessions (AVCaptureMultiCamSession). Audio input via AVCaptureAudioDataOutput (48 kHz mono 16-bit PCM) is supported.',
  },
  {
    q: 'Is SimCam Lite really free for teams and CI?',
    a: 'Yes. SimCam Lite is 100% free and MIT-licensed open source. There are no seat limits, watermarks, or commercial CI add-ons.',
  },
];
---

<section id="faq" class="faq-section" aria-labelledby="faq-heading">
  <div class="container">
    <header class="faq-head" data-reveal>
      <h2 id="faq-heading">Frequently asked questions</h2>
      <p>
        Answers to the most common questions. Looking for low-level internals? <a href="/docs/architecture/how-injection-works/">Read the architecture docs →</a>
      </p>
    </header>

    <div class="faq-grid">
      {faqs.map((item, i) => (
        <details class="faq-item" data-reveal style={`--reveal-delay: ${(i % 2) * 70}ms;`}>
          <summary class="faq-summary">
            <span>{item.q}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 56px 0 16px;
    scroll-margin-top: calc(var(--nav-height) + 16px);
  }

  .faq-head {
    max-width: 620px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .faq-head h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--landing-ink);
  }

  .faq-head p {
    margin: 0;
    font-size: 1rem;
    color: var(--landing-ink-secondary);
  }

  .faq-head a {
    color: var(--landing-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-head a:hover {
    opacity: 0.72;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: start;
  }

  .faq-item {
    min-width: 0;
    overflow-wrap: anywhere;
    border-radius: 22px;
    background-color: var(--landing-surface);
    padding: 22px 24px;
    overflow: clip;
  }

  .faq-item::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
    opacity: 1;
  }

  .faq-item:not([open])::details-content {
    block-size: 0;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      transition:
        block-size 0.32s var(--ease-out-expo),
        opacity 0.24s ease,
        content-visibility 0.32s var(--ease-out-expo),
        display 0.32s var(--ease-out-expo);
      transition-behavior: allow-discrete;
    }
  }

  .faq-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--landing-ink);
    cursor: pointer;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--landing-ink-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-chevron {
      transition: transform 0.28s var(--ease-out-expo);
    }
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding-top: 12px;
  }

  .faq-answer p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--landing-ink-secondary);
  }

  @media (max-width: 820px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .faq-item {
      padding: 18px;
      border-radius: 18px;
    }
  }
</style>

<script>
  // Progressive WAAPI expand/collapse fallback for browsers without CSS interpolate-size (Safari/Firefox)
  if (!CSS.supports('interpolate-size', 'allow-keywords') && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((details) => {
      const summary = details.querySelector<HTMLElement>('.faq-summary');
      const answer = details.querySelector<HTMLElement>('.faq-answer');
      if (!summary || !answer) return;

      let heightAnim: Animation | null = null;
      let fadeAnim: Animation | null = null;
      let state: 'idle' | 'expanding' | 'collapsing' = 'idle';

      const resetState = () => {
        heightAnim = null;
        fadeAnim = null;
        state = 'idle';
        details.style.height = '';
        answer.style.opacity = '';
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const startHeight = `${details.offsetHeight}px`;

        if (heightAnim) heightAnim.cancel();
        if (fadeAnim) fadeAnim.cancel();

        if (details.open && state !== 'collapsing') {
          // Collapse
          state = 'collapsing';
          const styles = getComputedStyle(details);
          const padY = parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
          const endHeight = `${summary.offsetHeight + padY}px`;

          details.style.height = startHeight;
          heightAnim = details.animate(
            { height: [startHeight, endHeight] },
            { duration: 280, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
          fadeAnim = answer.animate(
            { opacity: [1, 0] },
            { duration: 180, easing: 'ease-out', fill: 'forwards' }
          );

          heightAnim.onfinish = () => {
            details.open = false;
            resetState();
          };
          heightAnim.oncancel = () => {
            heightAnim = null;
            fadeAnim = null;
          };
        } else {
          // Expand
          state = 'expanding';
          details.style.height = '';
          details.open = true;
          const endHeight = `${details.offsetHeight}px`;
          details.style.height = startHeight;

          heightAnim = details.animate(
            { height: [startHeight, endHeight] },
            { duration: 300, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
          fadeAnim = answer.animate(
            { opacity: [0, 1] },
            { duration: 240, easing: 'ease-out' }
          );

          heightAnim.onfinish = () => {
            resetState();
          };
          heightAnim.oncancel = () => {
            heightAnim = null;
            fadeAnim = null;
          };
        }
      });
    });
  }
</script>

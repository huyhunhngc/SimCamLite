---
import { DOCS_SIDEBAR, TOP_NAV, normalizePath } from '@data/navigation';

interface Props {
  currentPath: string;
  variant?: 'sidebar' | 'drawer';
}

const { currentPath, variant = 'sidebar' } = Astro.props;
const normalized = normalizePath(currentPath);
---

{variant === 'sidebar' && (
  <nav class="sidebar-nav" aria-label="Documentation sections">
    {DOCS_SIDEBAR.map((group) => (
      <section class="sidebar-group">
        <h2 class="sidebar-group-title">{group.title}</h2>
        <ul class="sidebar-list">
          {group.items.map((item) => {
            const active = item.href === normalized;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['sidebar-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </nav>
)}

{variant === 'drawer' && (
  <dialog id="docs-drawer" class="drawer" aria-label="Documentation navigation">
    <div class="drawer-scroller">
      <nav class="drawer-sheet" aria-label="Mobile documentation sections">
        <div class="drawer-header">
          <span class="drawer-title">Documentation</span>
          <button type="button" id="docs-drawer-close" class="drawer-close" aria-label="Close documentation menu" autofocus>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="drawer-body">
          <section class="sidebar-group drawer-top-links">
            <ul class="sidebar-list">
              <li><a href="/" class="sidebar-link">Home</a></li>
              {TOP_NAV.filter((n) => n.href !== '/docs/get-started/introduction/').map((item) => (
                <li><a href={item.href} class="sidebar-link">{item.label}</a></li>
              ))}
            </ul>
          </section>

          {DOCS_SIDEBAR.map((group) => (
            <section class="sidebar-group">
              <h2 class="sidebar-group-title">{group.title}</h2>
              <ul class="sidebar-list">
                {group.items.map((item) => {
                  const active = item.href === normalized;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class:list={['sidebar-link', { active }]}
                        aria-current={active ? 'page' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </nav>
    </div>
  </dialog>
)}

<style>
  .sidebar-nav {
    display: flex;
    flex-direction: column;
  }

  .sidebar-group + .sidebar-group {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--docs-divider);
  }

  .sidebar-group-title {
    margin: 0 0 6px;
    padding: 4px 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    line-height: 22px;
    color: var(--docs-text-1);
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .sidebar-link {
    position: relative;
    display: block;
    padding: 5px 0 5px 12px;
    text-decoration: none;
    font-size: 13.5px;
    line-height: 22px;
    font-weight: 450;
    color: var(--docs-text-3);
    transition: color 0.15s ease;
  }

  .sidebar-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    bottom: 7px;
    width: 2px;
    border-radius: 1px;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }

  .sidebar-link:hover {
    color: var(--docs-text-1);
  }

  .sidebar-link.active {
    color: var(--docs-link);
    font-weight: 500;
  }

  .sidebar-link.active::before {
    background-color: var(--docs-link);
  }

  /* Native swipeable navigation drawer */
  .drawer {
    --drawer-width: min(20em, 80dvw, 100dvw - 24px);
    --drawer-backdrop: 0;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .drawer::backdrop {
    background: #000000;
    opacity: calc(var(--drawer-backdrop) / 2);
  }

  .drawer-scroller {
    position: relative;
    display: grid;
    grid-template-columns: var(--drawer-width) 100%;
    overflow-x: scroll;
    overscroll-behavior: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer-scroller {
      scroll-behavior: smooth;
    }
  }

  .drawer-scroller::after {
    content: '';
    scroll-snap-align: end;
    scroll-initial-target: nearest;
  }

  .drawer-sheet {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
    background-color: var(--docs-sidebar-bg);
    color: var(--docs-text-1);
    border-right: 1px solid var(--docs-divider);
    overflow-y: auto;
    scroll-snap-align: start;
    scrollbar-width: none;
  }

  @supports (animation-timeline: scroll()) {
    .drawer {
      timeline-scope: --drawer-fade;
      animation: fade-drawer-backdrop linear both;
      animation-timeline: --drawer-fade;
    }

    .drawer-scroller {
      scroll-timeline: --drawer-fade x;
    }

    @property --drawer-backdrop {
      syntax: '<number>';
      inherits: true;
      initial-value: 0;
    }

    @keyframes fade-drawer-backdrop {
      0% {
        --drawer-backdrop: 1;
      }
      100% {
        --drawer-backdrop: 0;
      }
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--docs-divider);
  }

  .drawer-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--docs-text-1);
  }

  .drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 0;
    background-color: transparent;
    color: var(--docs-text-2);
    cursor: pointer;
  }

  .drawer-close:hover {
    background-color: var(--docs-bg-soft);
    color: var(--docs-text-1);
  }

  .drawer-body {
    padding: 20px 24px 40px;
  }
</style>

<script>
  const drawer = document.getElementById('docs-drawer') as HTMLDialogElement | null;
  const openBtn = document.getElementById('docs-drawer-open');
  const closeBtn = document.getElementById('docs-drawer-close');
  const scroller = drawer?.querySelector<HTMLElement>('.drawer-scroller');
  const sheet = drawer?.querySelector<HTMLElement>('.drawer-sheet');

  if (drawer && openBtn && closeBtn && scroller && sheet) {
    let hasBecomeVisible = false;

    if (!CSS.supports('animation-timeline: scroll()')) {
      scroller.addEventListener('scroll', () => {
        const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / Math.max(sheet.offsetWidth, 1)));
        drawer.style.setProperty('--drawer-backdrop', String(ratio));
      });
    }

    const openDrawer = async () => {
      hasBecomeVisible = false;
      drawer.showModal();
      if (!CSS.supports('scroll-initial-target', 'nearest')) {
        scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'instant' });
        await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
      } else {
        await new Promise((r) => requestAnimationFrame(r));
      }
      scroller.scrollTo({ left: 0, behavior: 'auto' });
    };

    const closeDrawer = () => {
      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
      // Fallback in case scroll position was already at the closed stop or reduced-motion skips animation
      window.setTimeout(() => {
        if (drawer.open && scroller.scrollLeft >= sheet.offsetWidth - 2) {
          drawer.close();
          openBtn.setAttribute('aria-expanded', 'false');
        }
      }, 360);
    };

    const visibleThreshold = 1 / Math.max(window.innerWidth, 1);
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.at(-1);
        if (!entry) return;
        if (entry.intersectionRatio >= visibleThreshold) {
          hasBecomeVisible = true;
        }
        if (hasBecomeVisible && entry.intersectionRatio < visibleThreshold && drawer.open) {
          drawer.close();
          openBtn.setAttribute('aria-expanded', 'false');
        }
        if (entry.intersectionRatio === 1) {
          openBtn.setAttribute('aria-expanded', 'true');
        }
      },
      { root: drawer, threshold: [visibleThreshold, 1] }
    );
    observer.observe(sheet);

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);

    drawer.addEventListener('click', (event) => {
      if (!sheet.contains(event.target as Node)) closeDrawer();
    });

    drawer.addEventListener('cancel', (event) => {
      if (event.cancelable) {
        event.preventDefault();
        closeDrawer();
      }
    });

    drawer.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
    });

    sheet.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (drawer.open) drawer.close();
      });
    });
  }
</script>

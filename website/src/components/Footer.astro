---
import { APP_VERSION, GITHUB_REPO, LATEST_RELEASE_URL } from '@data/navigation';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="brand-name">SimCam Lite</span>
      </a>
      <p class="footer-tagline">
        A free, open-source camera for the iOS Simulator. Stream photos, 4K videos, QR codes, or your Mac’s webcam with zero code changes.
      </p>
      <p class="footer-meta">v{APP_VERSION} · MIT License · macOS 14.0+ · Xcode & iOS Simulator</p>
    </div>

    <div class="footer-col">
      <h3>Product</h3>
      <ul>
        <li><a href="/#features">Features</a></li>
        <li><a href="/#cli">CLI & Automation</a></li>
        <li><a href="/#install">Installation</a></li>
        <li><a href="/changelog/">Changelog</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Documentation</h3>
      <ul>
        <li><a href="/docs/get-started/introduction/">Introduction</a></li>
        <li><a href="/docs/get-started/quick-start/">Quick Start</a></li>
        <li><a href="/docs/guides/simulator-and-xcode/">Xcode & Simulator Setup</a></li>
        <li><a href="/docs/reference/cli/">CLI Reference</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Open Source</h3>
      <ul>
        <li><a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
        <li><a href={LATEST_RELEASE_URL} target="_blank" rel="noopener noreferrer">Latest Releases</a></li>
        <li><a href={`${GITHUB_REPO}/blob/master/CONTRIBUTING.md`} target="_blank" rel="noopener noreferrer">Contributing</a></li>
        <li><a href={`${GITHUB_REPO}/blob/master/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>Built for iOS developers. Free and open source under the MIT License.</span>
    <a href="/docs/architecture/how-injection-works/">How injection works →</a>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--landing-surface);
    padding: 64px 0 36px;
    margin-top: 88px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.7fr repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--landing-ink);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.025em;
  }

  .footer-tagline {
    margin: 12px 0 12px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--landing-ink-secondary);
    max-width: 340px;
  }

  .footer-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-col h3 {
    margin: 0 0 14px;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--landing-ink);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--landing-ink-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--landing-ink);
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer-bottom a {
    color: var(--landing-ink-secondary);
    text-decoration: none;
    font-weight: 500;
  }

  .footer-bottom a:hover {
    color: var(--landing-ink);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
